{
  "name": "nimbus",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter @nimbus/shared build && pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "metro": "0.81.5",
      "metro-babel-transformer": "0.81.5",
      "metro-cache": "0.81.5",
      "metro-cache-key": "0.81.5",
      "metro-config": "0.81.5",
      "metro-core": "0.81.5",
      "metro-file-map": "0.81.5",
      "metro-minify-terser": "0.81.5",
      "metro-resolver": "0.81.5",
      "metro-runtime": "0.81.5",
      "metro-source-map": "0.81.5",
      "metro-symbolicate": "0.81.5",
      "metro-transform-plugins": "0.81.5",
      "metro-transform-worker": "0.81.5",
      "react-native-reanimated": "~3.16.2",
      "react-native-worklets": "0.4.1",
      "@babel/core": "~7.25.0"
    }
  }
}
