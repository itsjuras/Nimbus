{
  "expo": {
    "name": "Nimbus",
    "slug": "nimbus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nimbus",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nimbus.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nimbus uses your camera to take job site photos.",
        "NSPhotoLibraryUsageDescription": "Nimbus uses your photo library to attach photos to jobs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nimbus.app",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#111827",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nimbus uses your photo library to attach photos to jobs.",
          "cameraPermission": "Nimbus uses your camera to take job site photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
